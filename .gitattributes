# Ensure 3D models and binary assets are treated as raw binary without line-ending conversions
*.glb binary
*.gltf binary

# Git Large File Storage (LFS) for heavy source project files
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
